+bool RecordingManager::prepareMobileMp3Recording() {
+    if (isRecordingActive()) {
+        return false;
+    }
+
+    const QString musicLocation =
+            QStandardPaths::writableLocation(QStandardPaths::MusicLocation);
+    const QString appDataLocation =
+            QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+
+    QString recordingDir;
+    if (!musicLocation.isEmpty()) {
+        recordingDir = QDir(musicLocation).filePath(QStringLiteral("Mixxx/Recordings"));
+    }
+
+    QDir directory;
+    if (recordingDir.isEmpty() || !directory.mkpath(recordingDir)) {
+        if (appDataLocation.isEmpty()) {
+            qWarning() << "Could not find a writable Android recording location";
+            return false;
+        }
+        recordingDir = QDir(appDataLocation).filePath(QStringLiteral("Recordings"));
+        if (!directory.mkpath(recordingDir)) {
+            qWarning() << "Could not create Android recording location" << recordingDir;
+            return false;
+        }
+    }
+
+    m_pConfig->set(ConfigKey(RECORDING_PREF_KEY, "Directory"),
+            ConfigValue(recordingDir));
+    m_pConfig->set(ConfigKey(RECORDING_PREF_KEY, "Encoding"),
+            ConfigValue(QStringLiteral(ENCODING_MP3)));
+    m_pConfig->set(ConfigKey(RECORDING_PREF_KEY, "FileSize"),
+            ConfigValue(QStringLiteral(SPLIT_NONE)));
+    setRecordingDir();
+
+    return !m_recordingDir.isEmpty() && QFileInfo(m_recordingDir).isDir();
+}
